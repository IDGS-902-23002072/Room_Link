# Base principal (NO se modifica el esquema desde el monitoreo)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=roomlink_app
DB_PASSWORD=roomlink_school
DB_NAME=roomlink

# Base independiente de monitoreo
MONITOR_DB_HOST=127.0.0.1
MONITOR_DB_PORT=3307
MONITOR_DB_USER=roomlink_monitor
MONITOR_DB_PASSWORD=roomlink_monitor_school
MONITOR_DB_NAME=roomlink_monitor

# Solo lectura para casos F4 (nunca se usa para escribir en roomlink)
MONITOR_READONLY_DB_USER=roomlink_app
MONITOR_READONLY_DB_PASSWORD=roomlink_school

# Token de servicio para la ingesta administrativa (F2/F3)
MONITOR_INGEST_TOKEN=cambia-este-token-en-produccion

# URL base usada por los scripts de sondeo e ingesta
ROOMLINK_BASE_URL=http://127.0.0.1:3000
# Base del endpoint de ingesta; cada script añade /probe, /backup o /test-run.
# Déjala vacía para usar ROOMLINK_BASE_URL.
MONITOR_INGEST_URL=http://127.0.0.1:3000/api/v1/admin/monitoring/ingest
