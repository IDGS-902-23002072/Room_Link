# Base principal (NO se modifica el esquema desde el monitoreo)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=roomlink_app
DB_PASSWORD=roomlink_school
DB_NAME=roomlink

# Base independiente de monitoreo
MONITOR_DB_HOST=127.0.0.1
MONITOR_DB_PORT=3307
MONITOR_DB_USER=roomlink_monitor
MONITOR_DB_PASSWORD=roomlink_monitor_school
